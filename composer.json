{
    "name": "example/vending-machine",
    "description": "A vending machine domain modelled with standalone Symfony components, Doctrine MongoDB ODM and Redis.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.4",
        "ext-amqp": "*",
        "ext-mongodb": "*",
        "doctrine/mongodb-odm": "^2.9",
        "predis/predis": "^2.3",
        "symfony/amqp-messenger": "^7.2",
        "symfony/clock": "^7.2",
        "symfony/config": "^7.2",
        "symfony/console": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/http-foundation": "^7.2",
        "symfony/http-kernel": "^7.2",
        "symfony/messenger": "^7.2",
        "symfony/routing": "^7.2",
        "symfony/validator": "^7.2",
        "symfony/yaml": "^7.2"
    },
    "require-dev": {
        "carthage-software/mago": "^1.56",
        "opis/json-schema": "^2.6",
        "phpunit/phpunit": "^11.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    },
    "scripts": {
        "test:unit": "phpunit --testsuite=unit",
        "test:integration": "phpunit --testsuite=integration",
        "test:functional": "phpunit --testsuite=functional",
        "test": "phpunit",
        "fmt": "mago format",
        "fmt:check": "mago format --check",
        "lint": "mago lint",
        "analyse": "mago analyze",
        "guard": "mago guard",
        "fix": "mago fix",
        "quality": [
            "@fmt:check",
            "@lint",
            "@analyse",
            "@guard"
        ]
    }
}
